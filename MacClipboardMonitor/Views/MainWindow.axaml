<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacClipboardMonitor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="550"
        x:Class="MacClipboardMonitor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MacClipboardMonitor"
        
        Width="350" Height="550"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
        CornerRadius="12">

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" PointerPressed="OnPointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Portapapeles" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           IsHitTestVisible="False" /> <Button Grid.Column="1" 
                        Command="{Binding ClearHistoryCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Borrar todo el historial">
                    <TextBlock Text="🗑️" FontSize="18" />
                </Button>

                <Button Grid.Column="2" 
                        Click="OnHideClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip.Tip="Ocultar panel">
                    <TextBlock Text="❌" FontSize="18" />
                </Button>
            </Grid>

            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding History}" 
                     SelectedItem="{Binding SelectedItem}"
                     Background="Transparent" 
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" 
                                Padding="14"
                                Margin="0,0,0,8"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock Text="{Binding Content}" 
                                       TextWrapping="Wrap" 
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="60" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>